{
  "name": "actions-comment-pull-request",
  "version": "3.0.1",
  "description": "GitHub action for commenting pull-request",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:main && npm run build:cleanup",
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=lib/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "build:cleanup": "esbuild src/cleanup.ts --bundle --platform=node --target=node24 --format=esm --outfile=lib/cleanup/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --write **/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thollander/actions-comment-pull-request"
  },
  "keywords": [
    "actions",
    "container",
    "pull-request",
    "comment",
    "message"
  ],
  "author": "Térence Hollander",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thollander/actions-comment-pull-request/issues"
  },
  "homepage": "https://github.com/thollander/actions-comment-pull-request#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@octokit/types": "^15.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
